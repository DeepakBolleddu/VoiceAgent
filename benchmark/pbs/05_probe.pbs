module load python/3.10.8-gcc-4ib
source ~/dl_env/bin/activate
cd ~/VoiceAgent/benchmark

echo "=== per-layer probing of difficulty on XLS-R embeddings (silver target) ==="
# audio-embedding -> silver: legitimate weak-label test (audio != transcript codes)
python scripts/probe_layers.py --config configs/hpc.yaml --target silver_pdi --layers all
echo "Done: $(date)"
